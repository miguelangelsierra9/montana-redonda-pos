# ==============================================================================
# MONTAÑA REDONDA PARADISE - .htaccess PARA HOSTING COMPARTIDO (Apache/LiteSpeed)
# ==============================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Forzar HTTPS (Obligatorio para que la cámara QR funcione en celulares)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Servir archivos existentes tal cual (.js, .css, imágenes, config.js)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Redirigir cualquier ruta del sistema al index.html (SPA)
  RewriteRule ^ index.html [L]
</IfModule>

# Evitar caché en config.js e index.html para que los cambios en cPanel sean inmediatos
<IfModule mod_headers.c>
  <FilesMatch "^(config\.js|index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>

